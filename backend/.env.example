# PlayRoomy API — variáveis para o painel da Discloud
# Copie para .env apenas em desenvolvimento local (não commite segredos).

# Obrigatório em produção: URL exata do frontend (sem barra no final)
# ALLOWED_ORIGINS=https://playroomy.vercel.app

# Limites opcionais (padrões seguros para 512 MB RAM)
# MAX_ROOMS=120
# MAX_CONNECTIONS=350
# MAX_PARTICIPANTS=20
# MAX_QUEUE_ITEMS=40
# EMPTY_ROOM_GRACE_MS=90000

# PORT=8080
# A Discloud define PORT automaticamente. Não altere em produção.
