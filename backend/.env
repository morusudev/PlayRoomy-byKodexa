# PlayRoomy API — backend
# Configure no painel da Discloud (produção). Este arquivo é só referência.

# ALLOWED_ORIGINS=
# URLs do frontend permitidas no CORS. Separe por vírgula se tiver mais de uma.

# MAX_ROOMS=
# Máximo de salas simultâneas (padrão: 120).

# MAX_CONNECTIONS=
# Máximo de conexões WebSocket (padrão: 350).

# MAX_PARTICIPANTS=
# Máximo de pessoas por sala (padrão: 20).

# MAX_QUEUE_ITEMS=
# Máximo de vídeos na playlist (padrão: 40).

# EMPTY_ROOM_GRACE_MS=
# Tempo em ms antes de apagar sala vazia (padrão: 90000).

# PORT=
# Discloud exige 8080. Não precisa alterar manualmente.
