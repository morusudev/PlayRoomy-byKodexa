# PlayRoomy — frontend
# Preencha os valores no painel da Vercel (produção) ou em .env.local (dev local).
# Este arquivo fica vazio no repositório como referência.

# VITE_APP_ID=
# Identificador único da sua instância. Todos na mesma sala precisam do mesmo valor.

# VITE_PUBLIC_URL=
# URL pública do site. Usada nos links de convite.

# VITE_WS_URL=
# URL do backend WebSocket (wss://). Ex.: wss://seu-app.discloud.app

# VITE_GITHUB_URL=
# Link do repositório open source (aparece no footer).

# VITE_BRAND_BY=
# Nome exibido no footer (ex.: sua marca ou equipe).

# VITE_KODEXA_URL=
# Link do site da marca (aparece no "by Kodexa").

# VITE_MAX_PARTICIPANTS=
# Limite de pessoas por sala (padrão: 20).
